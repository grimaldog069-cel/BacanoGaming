<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Bacano Gaming"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BacanoGaming">

        <activity
            android:name=".common.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".common.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".common.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".common.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".comprador.CompradorActivity"
            android:exported="false" />

        <activity
            android:name=".vendedor.VendedorActivity"
            android:exported="false" />

        <activity
            android:name=".admin.AdminActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>